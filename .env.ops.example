# === Credenciales de OPERACIÓN — plantilla ===
#
# Copia a .env.ops y rellena. Lo carga tools/ops, así ningún comando necesita
# que le peguen la URL de Postgres a mano.
#
# .env.ops está gitignored. Este .example NO lleva secretos a propósito.

# URLs PÚBLICAS de Railway (*.proxy.rlwy.net). Las internas
# (*.railway.internal) sólo funcionan dentro de la red de Railway.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PUERTO/railway
REDIS_URL=redis://default:PASSWORD@HOST.proxy.rlwy.net:PUERTO

# Debe coincidir EXACTAMENTE con la del web app y la del worker, o los tokens
# de Instagram guardados no se pueden descifrar.
ENCRYPTION_KEY=

APP_URL=https://tu-dominio.vercel.app

# Fuente de datos del Radar. Vacío = el Radar se ve pero no se llena.
APIFY_TOKEN=
