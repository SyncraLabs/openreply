# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# AI Operator webhook (optional). When both are set, every button tap, free-text
# reply and delivered link in a DM conversation is POSTed to the sales site so
# each lead gets a card there. Never blocks the DM: fire and forget, 5 s timeout.
# The secret is the same value as RODRICHAT_WEBHOOK_SECRET on the AI Operator side.
AIOPERATOR_WEBHOOK_URL=https://your-aioperator-domain.example/api/leads/rodrichat
AIOPERATOR_WEBHOOK_SECRET=replace-with-a-strong-random-secret
